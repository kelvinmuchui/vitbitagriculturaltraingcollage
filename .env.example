# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Protect the registrar dashboard. Use a unique password (12+ characters) and random secret (32+ characters).
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Nodemailer + Gmail SMTP (Google Account -> Security -> 2-Step Verification -> App passwords).
GMAIL_USER="vbitschoolofcoffeeagribusiness@gmail.com"
GMAIL_APP_PASSWORD=""
# Optional override if school admissions inbox differs from GMAIL_USER:
# SCHOOL_ADMISSIONS_EMAIL="vbitschoolofcoffeeagribusiness@gmail.com"

# Optional persistent SQLite database location. Defaults to ./data/applications.sqlite.
# On deployment, attach a persistent disk or use a managed database to retain applications across redeployments.
# DB_PATH=""
