# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EmailJS sends from the browser using its public key. Configure a Gmail service and an application
# template whose recipient is vbitschoolofcoffeeagribusiness@gmail.com. The applicant confirmation
# template is optional; if configured, set its recipient to {{applicant_email}}.
# These VITE_ values are public in the browser bundle; restrict allowed origins in EmailJS.
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
VITE_EMAILJS_APPLICATION_TEMPLATE_ID=""
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=""

# Application template variables: applicant_name, applicant_email, applicant_phone, national_id,
# date_of_birth, address, parent_name, parent_phone, parent_relationship, course_name,
# prior_experience, academic_grade, motivation, application_code, submitted_at, document_names.
# Optional confirmation template variables: applicant_name, applicant_email, course_name,
# application_code, submitted_at.

# Protect the registrar dashboard. Use a unique password (12+ characters) and random secret (32+ characters).
ADMIN_PASSWORD="Adminvibit@2026"
ADMIN_SESSION_SECRET="VIBIT_7xQm9KpL2vN8fR4wT6yH3cJ5sB1zA0uE9dG8hF2kM6pX"

# Optional persistent SQLite database location. Defaults to ./data/applications.sqlite.
# On deployment, attach a persistent disk or use a managed database to retain applications across redeployments.
# DB_PATH=""
